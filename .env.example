# Backend Configuration
# The host address for the backend server to bind to
BACKEND_HOST=0.0.0.0
# The port on which the backend server will listen
BACKEND_PORT=8000
# The environment type (development, staging, production)
BACKEND_ENV=development
# The logging level (debug, info, warning, error, critical)
BACKEND_LOG_LEVEL=info
# Comma-separated list of allowed CORS origins
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# Directory path for storing JSON data files
BACKEND_DATA_DIR=./data
# Rate limiting configuration (requests/interval)
BACKEND_RATE_LIMIT=100/minute

# Frontend Configuration
# URL of the backend API for the frontend to connect to
VITE_API_URL=http://localhost:8000
# The title of the frontend application
VITE_APP_TITLE=ExpenseTracker
