# Smart Expense Tracker - Environment Configuration
# ==================================================
# Copy this file to .env and adjust values as needed.
# cp .env.example .env

# --- Backend Settings ---
# Application environment: development | production | testing
BACKEND_ENVIRONMENT=development

# Backend log level: debug | info | warning | error
BACKEND_LOG_LEVEL=info

# Backend server port (default: 8000)
BACKEND_PORT=8000

# Comma-separated list of allowed CORS origins
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Data directory for JSON storage (relative to backend/)
BACKEND_DATA_DIR=./data

# Rate limiting (e.g., "100/minute", "30/second")
BACKEND_RATE_LIMIT=100/minute

# --- Frontend Settings ---
# API URL for the backend (used in dev mode)
VITE_API_URL=http://localhost:8000
