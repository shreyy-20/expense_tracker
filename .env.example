# =============================================================================
# Smart Expense Tracker - Environment Configuration
# =============================================================================
# Copy this file to .env and adjust values for your environment.
#   cp .env.example .env
#
# Backend settings use BACKEND_ prefix.
# Frontend settings use VITE_ prefix.
# =============================================================================

# --- Backend (FastAPI) ---
BACKEND_ENV=development
BACKEND_DEBUG=true
BACKEND_LOG_LEVEL=info
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:3000
BACKEND_DATA_DIR=./data
BACKEND_RATE_LIMIT=100/minute

# --- Frontend (Vite/React) ---
VITE_API_URL=http://localhost:8000

# --- Docker Compose ---
# Used by docker-compose.yml when env_file: .env is set
# BACKEND_DATA_DIR=/app/data  (override for Docker)
